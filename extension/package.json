{
  "name": "claude-status",
  "displayName": "Claude Code status",
  "description": "List the live Claude Code sessions in the Explorer, and go to the terminal that runs one.",
  "version": "0.9.0",
  "publisher": "claude-code-tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jelias3/vscode-claude-sessions.git"
  },
  "homepage": "https://github.com/jelias3/vscode-claude-sessions#readme",
  "bugs": {
    "url": "https://github.com/jelias3/vscode-claude-sessions/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "tmux",
    "terminal",
    "sessions"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeStatus.showRoster",
        "title": "Claude status: show the live Claude sessions"
      },
      {
        "command": "claudeStatus.attachAll",
        "title": "Claude status: open a tab for every session"
      },
      {
        "command": "claudeStatus.refresh",
        "title": "Claude status: read the roster again",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeStatus.writeReport",
        "title": "Claude status: report what it can see"
      },
      {
        "command": "claudeStatus.goTo",
        "title": "Claude status: go to this session"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "claudeStatus.sessions",
          "name": "Claude sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeStatus.sessions",
        "contents": "No Claude Code session is running on this machine.\nA session appears here as soon as it starts."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeStatus.goTo",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "claudeStatus.attachAll",
          "when": "view == claudeStatus.sessions"
        },
        {
          "command": "claudeStatus.refresh",
          "when": "view == claudeStatus.sessions",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Claude Code status",
      "properties": {
        "claudeStatus.configDirectory": {
          "type": "string",
          "default": "",
          "description": "The Claude Code configuration directory, which holds the session records. Leave it empty to use CLAUDE_CONFIG_DIR, and then ~/.claude."
        },
        "claudeStatus.stateDirectory": {
          "type": "string",
          "default": "",
          "description": "The directory the optional status line writer fills. Leave it empty to use statusline-state under the configuration directory."
        },
        "claudeStatus.pollSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 60,
          "description": "Seconds between two reads of the state directory."
        },
        "claudeStatus.noticeSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "maximum": 120,
          "description": "How long the status bar holds the notice that a session went idle."
        }
      }
    }
  }
}
